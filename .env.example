# ── LLM Provider ────────────────────────────────────────────
# mock:确定性 Mock(CI/单测/离线开发,零外部依赖)
# openai_compatible:任何 OpenAI 兼容端点(OpenAI/DeepSeek/本地 vLLM 等)
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# 模型路由表(逗号分隔,按优先级 fallback)
LLM_MODEL_CHAIN=primary,fast
LLM_MODEL_PRIMARY=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini

# ── PostgreSQL(读写分离)──────────────────────────────────
PG_PRIMARY_DSN=postgresql://agent:agent_pass@localhost:5432/agent_platform
PG_REPLICA_DSN=postgresql://agent:agent_pass@localhost:5433/agent_platform

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Pulsar ─────────────────────────────────────────────────
PULSAR_URL=pulsar://localhost:6650
PULSAR_HTTP_URL=http://localhost:8080
PULSAR_TENANT=agent-platform
PULSAR_NAMESPACE=core

# ── Milvus ─────────────────────────────────────────────────
MILVUS_URI=http://localhost:19530

# ── 可观测性 ───────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_ENABLED=true
